# Copy to .env and fill in. Never commit .env.

# Bybit EU (V5 API). Key: spot + margin trading only, no withdrawals, IP-whitelisted.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_BASE_URL=https://api.bybit.eu

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# X API (own copy of the existing keys, @decentradork)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Macro data
FRED_API_KEY=

# Database
DATABASE_URL=postgresql+psycopg://bot:bot@localhost:5432/bot
