# Copy to .env and fill in. Never commit .env.

# Bybit (V5 API). Key: spot trade only, no withdrawals, IP-whitelisted.
# Host must match where the key was created: api.bybit.com (global) or api.bybit.eu.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_BASE_URL=https://api.bybit.com

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# X API (own copy of the existing keys, @decentradork)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# Macro data
FRED_API_KEY=
COINGECKO_API_KEY=            # demo key; optional, raises the rate limit for /global

# Database
DATABASE_URL=postgresql+psycopg://bot:bot@localhost:5432/bot

# Tests: a separate database the destructive executor tests may wipe
TEST_DATABASE_URL=postgresql+psycopg://bot:bot@localhost:5432/bot_test

# Cloudflare (M8a): R2 bucket for the public snapshot, Pages for the site
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=          # Pages: edit, R2: edit
R2_BUCKET=dorkbot-public
R2_BACKUP_BUCKET=              # optional private bucket for nightly pg_dump files
R2_ACCESS_KEY_ID=              # R2 S3 API token
R2_SECRET_ACCESS_KEY=
SNAPSHOT_PUBLIC_URL=           # e.g. https://data.dorkbot.dev/snapshot.json

# Admin (M8b): only these reach the admin container, never the Bybit keys
ADMIN_SECRET_KEY=              # long random string; signs session cookies
ALERT_EMAIL_TO=alexanderstrobbe@gmail.com
ALERT_EMAIL_FROM=              # e.g. dorkbot Alerts <bot@dorkbot.dev>
RESEND_API_KEY=                # or SMTP_URL=smtp://user:pass@host:587
SMTP_URL=
